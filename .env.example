# EC2 서버의 ~/app/.env 로 복사한 뒤 값을 채우세요. (git에 올리지 마세요)

# --- 도커 이미지 (GHCR, 소문자로) ---
APP_IMAGE=ghcr.io/kau-chung-woon-ot/second_festival_backend

# --- 서비스 주소 ---
DOMAIN=api.example.com
APP_BASE_URL=https://api.example.com
OAUTH2_FRONT_REDIRECT_URI=https://example.com/oauth/callback
CORS_ALLOWED_ORIGINS=https://example.com
JWT_COOKIE_DOMAIN=.example.com

# --- DB (RDS 또는 별도 MySQL) ---
DB_URL=jdbc:mysql://your-rds-endpoint:3306/app?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=app
DB_PASSWORD=change-me
# 첫 배포 때만 update, 이후 validate
JPA_DDL_AUTO=update

# --- JWT (32바이트 이상 랜덤 문자열: openssl rand -base64 48) ---
JWT_SECRET=change-me-to-a-long-random-string

# --- 카카오 로그인 ---
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# --- Swagger 접속 계정 ---
SWAGGER_USERNAME=admin
SWAGGER_PASSWORD=change-me
